# Copy to a writable location and pass config_file:=/absolute/path/config.env.
# Explicit launch arguments override this file. Environment overrides file values.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
ROS_DOMAIN_ID=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# LOCAL_LOOPBACK is the safe default and refuses non-loopback binds.
WARETWIN_OPERATOR_AUTH_MODE=LOCAL_LOOPBACK
# PROTECTED_LAN is for a same-host TLS reverse proxy/auth gateway only. The
# proxy must strip all client X-WareTwin-* headers and add a fresh HMAC-signed
# identity/permissions/robot-scope assertion on each API request and WebSocket
# handshake. It must close the WebSocket when the gateway session expires.
# Never put the gateway secret in frontend config or browser JavaScript.
WARETWIN_OPERATOR_GATEWAY_SECRET=
WARETWIN_PUBLIC_ORIGINS=https://robot-hmi.example.invalid
WARETWIN_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# Blank secrets are generated once in runtime_dir/secrets.json (mode 0600).
DJANGO_SECRET_KEY=
WARETWIN_ROS_BRIDGE_TOKEN=
WARETWIN_ARTIFACT_ROOT=
