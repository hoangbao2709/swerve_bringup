# Django backend mode
VITE_DEMO_MODE=false
VITE_BACKEND_MODE=true
VITE_RUNTIME_MODE=GAZEBO_ROS

# Same-PC development defaults. For a browser on another PC, replace 127.0.0.1
# with the Django PC address and add that origin to backend/.env.
VITE_API_URL=http://127.0.0.1:8000
VITE_WS_URL=ws://127.0.0.1:8000/ws
