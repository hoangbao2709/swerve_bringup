<?xml version="1.0"?>
<package format="3">
  <name>waretwin_web</name>
  <version>0.1.0</version>
  <description>Installed WareTwin Django ASGI and production React application.</description>
  <maintainer email="dev@waretwin.local">WareTwin</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3</exec_depend>
  <exec_depend>python3-venv</exec_depend>
  <!-- Web dependencies are pinned in runtime/requirements.lock and installed
       into an isolated Python 3.10 venv by setup, never by launch. -->
  <export><build_type>ament_cmake</build_type></export>
</package>
