DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=5173
ROS_DOMAIN_ID=0
ROS_WS_URL=ws://127.0.0.1:8000/ws/ros
TWIN_SEED=42
TWIN_AUTOPLAY=1
TWIN_AUTH_REQUIRED=1
WARETWIN_RUNTIME_MODE=GAZEBO_ROS
WARETWIN_ROS_BRIDGE_TOKEN=change-me
WARETWIN_ROS_HEARTBEAT_TIMEOUT_S=10.0
WARETWIN_ARTIFACT_ROOT=
TWIN_ADMIN_USERNAME=admin
TWIN_ADMIN_EMAIL=admin@example.com
# Required only when the configured admin does not exist. Never commit a real
# password; setup_full_stack generates a random local value when this is blank.
TWIN_ADMIN_PASSWORD=
# Optional AI later:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o-mini
# TWIN_VLM_ACTS=0
