<?xml version="1.0"?>
<package format="3">
  <name>swerve_bridge</name>
  <version>0.1.0</version>
  <description>ROS2 to WareTwin Django bridge for telemetry and Nav2 goals.</description>
  <maintainer email="dev@waretwin.local">WareTwin</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>nav2_msgs</depend>
  <depend>action_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>python3-websocket</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
