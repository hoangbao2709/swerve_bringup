# Copy to a writable location and pass config_file:=/absolute/path/config.env.
# Explicit launch arguments override this file. Environment overrides file values.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
ROS_DOMAIN_ID=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Blank secrets are generated once in runtime_dir/secrets.json (mode 0600).
DJANGO_SECRET_KEY=
WARETWIN_ROS_BRIDGE_TOKEN=
WARETWIN_ARTIFACT_ROOT=
