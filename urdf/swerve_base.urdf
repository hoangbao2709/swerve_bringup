<?xml version="1.0"?>
<!--
  AGV base URDF - sinh tự động từ file STEP 096626040039-1.STEP
  Quy ước - base_link tại tâm bbox của khung chính (096626040020), X = hướng tới,
  Y = trái, Z = lên (đã remap từ hệ Y-up gốc của SolidWorks sang Z-up chuẩn ROS).

  GIẢ ĐỊNH CẦN NGƯỜI DÙNG KIỂM TRA LẠI -
  1. Khối lượng & quán tính - ước lượng từ thể tích hình học x mật độ giả định
     (nhôm 2700 kg/m3 cho khung/cụm xoay, 1500 kg/m3 cho bánh bị động) - KHÔNG
     phải số liệu vật lý thật, chỉ dùng tạm cho mô phỏng.
  2. Trục xoay của 2 cụm xoay (steer_front, steer_rear) - giả định trục đứng Z
     tại đúng tâm bbox của cụm - có thể lệch so với trục xoay cơ khí thật
     (trục xoay thật thường là tâm ổ bi/bạc đạn, cần xác nhận lại trên CAD).
  3. Trục lăn của 4 bánh bị động - giả định trục ngang Y (vuông góc hướng đi) -
     CẦN XÁC NHẬN - bánh CFAV2-D50-120 là bánh lăn cố định 1 bậc tự do, hay là
     bánh caster tự lựa hướng (2 bậc tự do - xoay quanh Z + lăn quanh trục ngang)?
     Nếu là caster, cần thêm 1 khớp revolute/continuous quanh Z trước khớp lăn.
  4. Cụm xoay (096626040011 / 096626040016) trong STEP chỉ chứa driver+heatsink+
     board, CHƯA thấy bánh xe dẫn động tách biệt trong cây assembly cấp này -
     có thể bánh nằm trong subassembly con (096626040035 / 096626040018) chưa
     được tách. Nếu cần khớp lăn của bánh chủ động riêng, tôi cần đào sâu thêm
     vào 2 subassembly đó.
-->
<robot name="agv_base" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Sensor placement/configuration arguments. Defaults are ESTIMATES and
       are overridden by launch/config when real measurements are available. -->
  <xacro:arg name="lidar_x" default="0.0"/>
  <xacro:arg name="lidar_y" default="0.0"/>
  <xacro:arg name="lidar_z" default="0.35"/>
  <xacro:arg name="lidar_roll" default="0.0"/>
  <xacro:arg name="lidar_pitch" default="0.0"/>
  <xacro:arg name="lidar_yaw" default="0.0"/>
  <xacro:arg name="lidar_horizontal_fov" default="6.283185307"/>
  <xacro:arg name="lidar_vertical_fov" default="0.523599"/>
  <xacro:arg name="lidar_horizontal_samples" default="720"/>
  <xacro:arg name="lidar_vertical_samples" default="16"/>
  <xacro:arg name="lidar_min_range" default="0.20"/>
  <xacro:arg name="lidar_max_range" default="30.0"/>
  <xacro:arg name="lidar_update_rate" default="10.0"/>
  <xacro:arg name="lidar_noise_stddev" default="0.01"/>
  <xacro:arg name="imu_x" default="0.0"/>
  <xacro:arg name="imu_y" default="0.0"/>
  <xacro:arg name="imu_z" default="0.30"/>
  <xacro:arg name="imu_roll" default="0.0"/>
  <xacro:arg name="imu_pitch" default="0.0"/>
  <xacro:arg name="imu_yaw" default="0.0"/>
  <xacro:arg name="imu_update_rate" default="100.0"/>
  <xacro:arg name="imu_gyro_noise_stddev" default="0.002"/>
  <xacro:arg name="imu_accel_noise_stddev" default="0.02"/>
  <xacro:arg name="enable_contact_sensors" default="false"/>
  <xacro:arg name="caster_frictionless" default="false"/>
  <xacro:arg name="proper_caster_test" default="false"/>
  <!-- Test-only physical-caster geometry.  Defaults intentionally reproduce
       the audited zero-trail prototype until a real measurement is supplied. -->
  <xacro:arg name="caster_axle_offset_x_m" default="0.0"/>
  <xacro:arg name="caster_axle_offset_y_m" default="0.0"/>
  <!-- TEST-ONLY proper-caster contact/joint dynamics.  These defaults retain
       the audited prototype; none are a production material calibration. -->
  <xacro:arg name="proper_caster_mu1" default="0.01"/>
  <xacro:arg name="proper_caster_mu2" default="0.01"/>
  <xacro:arg name="caster_swivel_friction" default="0.02"/>
  <xacro:arg name="caster_swivel_damping" default="0.02"/>
  <xacro:arg name="caster_roll_friction" default="0.02"/>
  <xacro:arg name="caster_roll_damping" default="0.02"/>
  <!-- Diagnostic switch: lets Gazebo physics be tested independently from
       gazebo_ros2_control without changing production's default behaviour. -->
  <xacro:arg name="enable_gazebo_ros2_control" default="true"/>
  <!-- Render the CAD-derived, decimated visual assets by default.  Setting
       use_cad_visuals:=false selects the deliberately simple visual-only
       primitives below; it never changes collision, inertial, joints or
       ros2_control. -->
  <xacro:arg name="use_cad_visuals" default="true"/>

  <xacro:property name="lidar_x" value="$(arg lidar_x)"/>
  <xacro:property name="lidar_y" value="$(arg lidar_y)"/>
  <xacro:property name="lidar_z" value="$(arg lidar_z)"/>
  <xacro:property name="lidar_roll" value="$(arg lidar_roll)"/>
  <xacro:property name="lidar_pitch" value="$(arg lidar_pitch)"/>
  <xacro:property name="lidar_yaw" value="$(arg lidar_yaw)"/>
  <xacro:property name="lidar_horizontal_fov" value="$(arg lidar_horizontal_fov)"/>
  <xacro:property name="lidar_vertical_fov" value="$(arg lidar_vertical_fov)"/>
  <xacro:property name="lidar_horizontal_samples" value="$(arg lidar_horizontal_samples)"/>
  <xacro:property name="lidar_vertical_samples" value="$(arg lidar_vertical_samples)"/>
  <xacro:property name="lidar_min_range" value="$(arg lidar_min_range)"/>
  <xacro:property name="lidar_max_range" value="$(arg lidar_max_range)"/>
  <xacro:property name="lidar_update_rate" value="$(arg lidar_update_rate)"/>
  <xacro:property name="lidar_noise_stddev" value="$(arg lidar_noise_stddev)"/>
  <xacro:property name="imu_x" value="$(arg imu_x)"/>
  <xacro:property name="imu_y" value="$(arg imu_y)"/>
  <xacro:property name="imu_z" value="$(arg imu_z)"/>
  <xacro:property name="imu_roll" value="$(arg imu_roll)"/>
  <xacro:property name="imu_pitch" value="$(arg imu_pitch)"/>
  <xacro:property name="imu_yaw" value="$(arg imu_yaw)"/>
  <xacro:property name="imu_update_rate" value="$(arg imu_update_rate)"/>
  <xacro:property name="imu_gyro_noise_stddev" value="$(arg imu_gyro_noise_stddev)"/>
  <xacro:property name="imu_accel_noise_stddev" value="$(arg imu_accel_noise_stddev)"/>
  <xacro:property name="caster_axle_offset_x_m" value="$(arg caster_axle_offset_x_m)"/>
  <xacro:property name="caster_axle_offset_y_m" value="$(arg caster_axle_offset_y_m)"/>
  <xacro:property name="proper_caster_mu1" value="$(arg proper_caster_mu1)"/>
  <xacro:property name="proper_caster_mu2" value="$(arg proper_caster_mu2)"/>
  <xacro:property name="caster_swivel_friction" value="$(arg caster_swivel_friction)"/>
  <xacro:property name="caster_swivel_damping" value="$(arg caster_swivel_damping)"/>
  <xacro:property name="caster_roll_friction" value="$(arg caster_roll_friction)"/>
  <xacro:property name="caster_roll_damping" value="$(arg caster_roll_damping)"/>
  <xacro:property name="passive_caster_mu1" value="${caster_mu}"/>
  <xacro:property name="passive_caster_mu2" value="${caster_mu}"/>
  <xacro:if value="$(arg proper_caster_test)">
    <xacro:property name="passive_caster_mu1" value="${proper_caster_mu1}"/>
    <xacro:property name="passive_caster_mu2" value="${proper_caster_mu2}"/>
  </xacro:if>
  <xacro:property name="caster_mu" value="0.01"/>
  <xacro:if value="$(arg caster_frictionless)"><xacro:property name="caster_mu" value="0.0"/></xacro:if>

  <!-- Test-only physical caster.  The default branch below is intentionally
       unchanged; this branch adds the missing swivel + rolling DOFs.  CAD and
       a CFAV2-D50-120 drawing in this workspace do not specify a trail, so
       this is explicitly a zero-trail passive swivel-wheel approximation. -->
  <xacro:macro name="proper_caster" params="name x y axle_offset_x axle_offset_y">
    <link name="${name}_fork_link">
      <inertial>
        <mass value="0.08"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
      </inertial>
    </link>
    <joint name="${name}_swivel_joint" type="continuous">
      <parent link="base_link"/><child link="${name}_fork_link"/>
      <origin xyz="${x} ${y} -0.20157"/><axis xyz="0 0 1"/>
      <dynamics friction="${caster_swivel_friction}" damping="${caster_swivel_damping}"/>
    </joint>
    <link name="${name}_link">
      <!-- The wheel link frame is its axle centre.  Keep visual and collision
           co-located so the rendered geometry exposes the actual roll axis. -->
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="0.040" length="0.040"/></geometry>
        <material name="dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <!-- Cylinder axis is Y; this is the rolling DOF of the test caster. -->
        <geometry><cylinder radius="0.040" length="0.040"/></geometry>
      </collision>
      <inertial>
        <mass value="0.443"/>
        <inertia ixx="0.000327" ixy="0" ixz="0" iyy="0.000327" iyz="0" izz="0.000327"/>
      </inertial>
    </link>
    <joint name="${name}_roll_joint" type="continuous">
      <parent link="${name}_fork_link"/><child link="${name}_link"/>
      <!-- Wheel axle centre relative to the vertical swivel axis.  X/Y are
           an explicit local planar vector, not a calibration scale.  The
           sign must come from CAD/measurement in caster local axes.  Keeping
           Z unchanged preserves contact height when only trail is added. -->
      <origin xyz="${axle_offset_x} ${axle_offset_y} -0.0034"/><axis xyz="0 1 0"/>
      <dynamics friction="${caster_roll_friction}" damping="${caster_roll_damping}"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="contact_sensor" params="link collision_name">
    <gazebo reference="${link}">
      <sensor name="${link}_contact_sensor" type="contact">
        <always_on>true</always_on><update_rate>50.0</update_rate>
        <contact><collision>${collision_name}</collision></contact>
        <plugin name="${link}_contact_plugin" filename="libgazebo_ros_bumper.so">
          <ros><namespace>/contact_load</namespace><remapping>bumper_states:=${link}</remapping></ros>
          <frame_name>${link}</frame_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- Visual-only passive caster approximation.  The audited physics branch
       remains a single low-friction cylinder at the existing joint origin;
       these parts only replace the misleading sphere rendered in Gazebo. -->
  <xacro:macro name="passive_caster_visuals">
    <visual>
      <origin xyz="0 0 0.012" rpy="0 0 0"/>
      <geometry><box size="0.090 0.090 0.018"/></geometry>
      <material name="metal"/>
    </visual>
    <visual>
      <origin xyz="0 0.026 -0.014" rpy="0 0 0"/>
      <geometry><box size="0.060 0.012 0.060"/></geometry>
      <material name="metal"/>
    </visual>
    <visual>
      <origin xyz="0 -0.026 -0.014" rpy="0 0 0"/>
      <geometry><box size="0.060 0.012 0.060"/></geometry>
      <material name="metal"/>
    </visual>
    <visual>
      <origin xyz="0 0 -0.0234" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.040" length="0.040"/></geometry>
      <material name="rubber"/>
    </visual>
  </xacro:macro>

  <material name="grey"><color rgba="0.32 0.35 0.38 1"/></material>
  <material name="orange"><color rgba="0.95 0.32 0.04 1"/></material>
  <material name="dark"><color rgba="0.08 0.09 0.10 1"/></material>
  <material name="metal"><color rgba="0.16 0.18 0.21 1"/></material>
  <material name="rubber"><color rgba="0.025 0.025 0.03 1"/></material>
  <material name="sensor_black"><color rgba="0.015 0.015 0.018 1"/></material>
  <material name="front_marker"><color rgba="0.95 0.75 0.05 1"/></material>

  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 -0.026" rpy="0 0 0"/>
      <geometry><cylinder radius="0.065" length="0.018"/></geometry>
      <material name="metal"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.000" rpy="0 0 0"/>
      <geometry><cylinder radius="0.055" length="0.050"/></geometry>
      <material name="dark"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.031" rpy="0 0 0"/>
      <geometry><cylinder radius="0.046" length="0.012"/></geometry>
      <material name="sensor_black"/>
    </visual>
    <visual>
      <origin xyz="0.032 0 0.039" rpy="0 0 0"/>
      <geometry><box size="0.020 0.012 0.006"/></geometry>
      <material name="front_marker"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.055" length="0.07"/></geometry>
    </collision>
    <inertial>
      <mass value="0.25"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/>
    </inertial>
  </link>
  <joint name="base_lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${lidar_x} ${lidar_y} ${lidar_z}"
            rpy="${lidar_roll} ${lidar_pitch} ${lidar_yaw}"/>
  </joint>

  <link name="imu_link">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="base_imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${imu_x} ${imu_y} ${imu_z}"
            rpy="${imu_roll} ${imu_pitch} ${imu_yaw}"/>
  </joint>

  <!-- V30E DataMatrix reader, downward-facing, nominal working height 0.10 m. -->
  <link name="v30e_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.09 0.07 0.025"/></geometry>
      <material name="dark"/>
    </visual>
    <!-- Visual-only downward lens/window; the fixed frame and sensing pose
         remain exactly the audited v30e_link transform. -->
    <visual>
      <origin xyz="0 0 -0.014" rpy="0 0 0"/>
      <geometry><cylinder radius="0.016" length="0.003"/></geometry>
      <material name="sensor_black"/>
    </visual>
    <visual>
      <origin xyz="0.030 0 0.014" rpy="0 0 0"/>
      <geometry><box size="0.028 0.008 0.004"/></geometry>
      <material name="front_marker"/>
    </visual>
  </link>
  <joint name="base_v30e_joint" type="fixed">
    <parent link="base_link"/><child link="v30e_link"/>
    <origin xyz="0 0 -0.145" rpy="0 0 0"/>
  </joint>

  <!-- base_footprint - hinh chieu cua robot xuong mat dat (z=0), theo chuan REP-120 cho Nav2.
       Do cao uoc luong tu diem tiep dat thap nhat trong 2 loai banh (chu dong + bi dong),
       lech nhau ~3mm giua 2 uoc luong -> lay trung binh. -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.245" rpy="0 0 0"/>
  </joint>

  <!-- ========================= BASE LINK ========================= -->
  <link name="base_link">
    <visual>
      <xacro:if value="$(arg use_cad_visuals)">
        <!-- CAD-derived visual mesh; OBJ coordinates are metres.  The source
             600k-triangle STL remains available in meshes/ unchanged. -->
        <geometry><mesh filename="package://swerve_bringup/meshes/visual/base_frame_visual.obj" scale="1 1 1"/></geometry>
      </xacro:if>
      <xacro:unless value="$(arg use_cad_visuals)">
        <!-- APPROXIMATED_VISUAL - render-only fallback, not collision truth. -->
        <geometry><box size="1.196 0.596 0.460"/></geometry>
      </xacro:unless>
      <material name="grey"/>
    </visual>
    <!-- Visual-only front marker, +X is the robot FRONT. -->
    <visual>
      <origin xyz="0.598 0 0.055" rpy="0 0 0"/>
      <geometry><box size="0.012 0.230 0.130"/></geometry>
      <material name="front_marker"/>
    </visual>
    <!-- Collision follows the measured mesh bbox (X/Y/Z = 1.196/0.596/0.460 m).
         The former Y/Z-swapped box penetrated the ground at the nominal footprint. -->
    <collision>
      <geometry><box size="1.196 0.596 0.460"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.02200 -0.00767 -0.11855" rpy="0 0 0"/>
      <mass value="73.363"/>
      <inertia ixx="2.079253" ixy="-0.094130" ixz="-0.013942" iyy="5.825588" iyz="0.050887" izz="7.096724"/>
    </inertial>
  </link>

  <!-- ===================== CỤM XOAY PHÍA TRƯỚC (steer_front) ===================== -->
  <link name="steer_front_link">
    <visual>
      <xacro:if value="$(arg use_cad_visuals)">
        <geometry><mesh filename="package://swerve_bringup/meshes/visual/steer_front_visual.obj" scale="1 1 1"/></geometry>
      </xacro:if>
      <xacro:unless value="$(arg use_cad_visuals)">
        <!-- APPROXIMATED_VISUAL - render-only fallback, not collision truth. -->
        <geometry><box size="0.2296 0.1862 0.2703"/></geometry>
      </xacro:unless>
      <material name="orange"/>
    </visual>
    <collision>
      <geometry><box size="0.2296 0.1862 0.2703"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.006446 -0.003031 -0.054617" rpy="0 0 0"/>
      <mass value="4.6944"/>
      <inertia ixx="0.025448" ixy="-0.0000348" ixz="-0.000455" iyy="0.018267" iyz="0.002865" izz="0.026107"/>
    </inertial>
  </link>

  <joint name="steer_front_joint" type="continuous">
    <parent link="base_link"/>
    <child link="steer_front_link"/>
    <origin xyz="0.300042 0.049988 -0.085893" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="100.0" velocity="6.0"/>
    <dynamics friction="0.1" damping="0.05"/>
  </joint>

  <!-- ===================== CỤM XOAY PHÍA SAU (steer_rear) ===================== -->
  <link name="steer_rear_link">
    <visual>
      <xacro:if value="$(arg use_cad_visuals)">
        <geometry><mesh filename="package://swerve_bringup/meshes/visual/steer_rear_visual.obj" scale="1 1 1"/></geometry>
      </xacro:if>
      <xacro:unless value="$(arg use_cad_visuals)">
        <!-- APPROXIMATED_VISUAL - render-only fallback, not collision truth. -->
        <geometry><box size="0.2296 0.1862 0.2834"/></geometry>
      </xacro:unless>
      <material name="orange"/>
    </visual>
    <collision>
      <geometry><box size="0.2296 0.1862 0.2834"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.006446 0.003031 -0.054617" rpy="0 0 0"/>
      <mass value="4.6944"/>
      <inertia ixx="0.025448" ixy="-0.0000348" ixz="0.000455" iyy="0.018267" iyz="-0.002865" izz="0.026107"/>
    </inertial>
  </link>

  <joint name="steer_rear_joint" type="continuous">
    <parent link="base_link"/>
    <child link="steer_rear_link"/>
    <origin xyz="-0.300042 0.050013 -0.085893" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="100.0" velocity="6.0"/>
    <dynamics friction="0.1" damping="0.05"/>
  </joint>

  <!-- ===================== 4 BÁNH BỊ ĐỘNG (CFAV2-D50-120) ===================== -->

  <xacro:unless value="$(arg proper_caster_test)">
  <!-- Banh bi dong FRONT LEFT - don gian hoa thanh khoi cau (bo swivel+roll, phu hop caster tu do) -->
  <link name="wheel_front_left_link">
    <xacro:passive_caster_visuals/>
    <!-- Stable low-friction primitive; the swivel DOF and low contact
         friction keep this passive support from locking the chassis. -->
    <collision><origin xyz="0 0 -0.0234"/><geometry><cylinder radius="0.040" length="0.040"/></geometry></collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.443"/>
      <inertia ixx="0.000327" ixy="0" ixz="0" iyy="0.000327" iyz="0" izz="0.000327"/>
    </inertial>
  </link>
  <joint name="wheel_front_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_front_left_link"/>
    <origin xyz="0.505 0.195 -0.20157" rpy="0 0 0"/>
    <axis xyz="0 0 1"/><dynamics friction="0.02" damping="0.05"/>
  </joint>

  <!-- Banh bi dong FRONT RIGHT - don gian hoa thanh khoi cau (bo swivel+roll, phu hop caster tu do) -->
  <link name="wheel_front_right_link">
    <xacro:passive_caster_visuals/>
    <collision><origin xyz="0 0 -0.0234"/><geometry><cylinder radius="0.040" length="0.040"/></geometry></collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.443"/>
      <inertia ixx="0.000327" ixy="0" ixz="0" iyy="0.000327" iyz="0" izz="0.000327"/>
    </inertial>
  </link>
  <joint name="wheel_front_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_front_right_link"/>
    <origin xyz="0.505 -0.195 -0.20157" rpy="0 0 0"/>
    <axis xyz="0 0 1"/><dynamics friction="0.02" damping="0.05"/>
  </joint>

  <!-- Banh bi dong REAR LEFT - don gian hoa thanh khoi cau (bo swivel+roll, phu hop caster tu do) -->
  <link name="wheel_rear_left_link">
    <xacro:passive_caster_visuals/>
    <collision><origin xyz="0 0 -0.0234"/><geometry><cylinder radius="0.040" length="0.040"/></geometry></collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.443"/>
      <inertia ixx="0.000327" ixy="0" ixz="0" iyy="0.000327" iyz="0" izz="0.000327"/>
    </inertial>
  </link>
  <joint name="wheel_rear_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rear_left_link"/>
    <origin xyz="-0.505 0.195 -0.20157" rpy="0 0 0"/>
    <axis xyz="0 0 1"/><dynamics friction="0.02" damping="0.05"/>
  </joint>

  <!-- Banh bi dong REAR RIGHT - don gian hoa thanh khoi cau (bo swivel+roll, phu hop caster tu do) -->
  <link name="wheel_rear_right_link">
    <xacro:passive_caster_visuals/>
    <collision><origin xyz="0 0 -0.0234"/><geometry><cylinder radius="0.040" length="0.040"/></geometry></collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.443"/>
      <inertia ixx="0.000327" ixy="0" ixz="0" iyy="0.000327" iyz="0" izz="0.000327"/>
    </inertial>
  </link>
  <joint name="wheel_rear_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rear_right_link"/>
    <origin xyz="-0.505 -0.195 -0.20157" rpy="0 0 0"/>
    <axis xyz="0 0 1"/><dynamics friction="0.02" damping="0.05"/>
  </joint>
  </xacro:unless>

  <xacro:if value="$(arg proper_caster_test)">
    <xacro:proper_caster name="wheel_front_left" x="0.505" y="0.195" axle_offset_x="${caster_axle_offset_x_m}" axle_offset_y="${caster_axle_offset_y_m}"/>
    <xacro:proper_caster name="wheel_front_right" x="0.505" y="-0.195" axle_offset_x="${caster_axle_offset_x_m}" axle_offset_y="${caster_axle_offset_y_m}"/>
    <xacro:proper_caster name="wheel_rear_left" x="-0.505" y="0.195" axle_offset_x="${caster_axle_offset_x_m}" axle_offset_y="${caster_axle_offset_y_m}"/>
    <xacro:proper_caster name="wheel_rear_right" x="-0.505" y="-0.195" axle_offset_x="${caster_axle_offset_x_m}" axle_offset_y="${caster_axle_offset_y_m}"/>
  </xacro:if>

  <!-- Banh chu dong (uoc luong - hinh hoc that nam trong khoi opaque HZ-CS95, khong tach duoc) -->
  <link name="wheel_front_drive_link">
    <visual>
      <xacro:if value="$(arg use_cad_visuals)">
        <geometry><mesh filename="package://swerve_bringup/meshes/visual/drive_front_visual.obj" scale="1 1 1"/></geometry>
      </xacro:if>
      <xacro:unless value="$(arg use_cad_visuals)">
        <!-- APPROXIMATED_VISUAL - render-only fallback, not collision truth. -->
        <geometry><cylinder radius="0.0675" length="0.065"/></geometry>
      </xacro:unless>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="rubber"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.0675" length="0.065"/></geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </collision>
    <inertial>
      <origin xyz="-0.0000522 0.051140 -0.0000062" rpy="0 0 0"/>
      <mass value="0.5933"/>
      <inertia ixx="0.000749" ixy="0.0" ixz="0.0" iyy="0.001289" iyz="0.0" izz="0.000749"/>
    </inertial>
  </link>
  <joint name="wheel_front_drive_joint" type="continuous">
    <parent link="steer_front_link"/>
    <child link="wheel_front_drive_link"/>
    <!-- Keep the driven wheel slightly below the passive caster contact plane
         so it carries load instead of free-spinning above the floor. -->
    <origin xyz="0.0 -0.0482 -0.0916" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="200.0" velocity="30.0"/>
    <dynamics friction="0.05" damping="0.10"/>
  </joint>

  <!-- Banh chu dong (uoc luong - hinh hoc that nam trong khoi opaque HZ-CS95, khong tach duoc) -->
  <link name="wheel_rear_drive_link">
    <visual>
      <xacro:if value="$(arg use_cad_visuals)">
        <geometry><mesh filename="package://swerve_bringup/meshes/visual/drive_rear_visual.obj" scale="1 1 1"/></geometry>
      </xacro:if>
      <xacro:unless value="$(arg use_cad_visuals)">
        <!-- APPROXIMATED_VISUAL - render-only fallback, not collision truth. -->
        <geometry><cylinder radius="0.0675" length="0.065"/></geometry>
      </xacro:unless>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="rubber"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.0675" length="0.065"/></geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </collision>
    <inertial>
      <origin xyz="0.0000522 -0.051140 -0.0000062" rpy="0 0 0"/>
      <mass value="0.5933"/>
      <inertia ixx="0.000749" ixy="0.0" ixz="0.0" iyy="0.001289" iyz="0.0" izz="0.000749"/>
    </inertial>
  </link>

  <xacro:if value="$(arg enable_contact_sensors)">
    <xacro:contact_sensor link="wheel_front_drive_link" collision_name="wheel_front_drive_link_collision"/>
    <xacro:contact_sensor link="wheel_rear_drive_link" collision_name="wheel_rear_drive_link_collision"/>
    <xacro:contact_sensor link="wheel_front_left_link" collision_name="wheel_front_left_link_collision"/>
    <xacro:contact_sensor link="wheel_front_right_link" collision_name="wheel_front_right_link_collision"/>
    <xacro:contact_sensor link="wheel_rear_left_link" collision_name="wheel_rear_left_link_collision"/>
    <xacro:contact_sensor link="wheel_rear_right_link" collision_name="wheel_rear_right_link_collision"/>
    <xacro:contact_sensor link="base_link" collision_name="base_link_collision"/>
    <xacro:contact_sensor link="steer_front_link" collision_name="steer_front_link_collision"/>
    <xacro:contact_sensor link="steer_rear_link" collision_name="steer_rear_link_collision"/>
  </xacro:if>
  <joint name="wheel_rear_drive_joint" type="continuous">
    <parent link="steer_rear_link"/>
    <child link="wheel_rear_drive_link"/>
    <!-- Rear housing is mirrored about the chassis centreline.  Use the
         mirrored lateral offset so both driven contact patches are at
         y~=0; otherwise straight +X drive applies a constant yaw moment. -->
    <origin xyz="0.0 -0.0482 -0.0916" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="200.0" velocity="30.0"/>
    <dynamics friction="0.05" damping="0.10"/>
  </joint>
  <!-- Gazebo Classic contact/friction parameters. These are initial values only. -->
  <gazebo reference="base_link">
    <mu1>0.05</mu1>
    <mu2>0.05</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <maxVel>0.1</maxVel>
    <minDepth>0.0</minDepth>
  </gazebo>
  <gazebo reference="steer_front_link">
    <mu1>0.6</mu1><mu2>0.6</mu2><kp>1000000.0</kp><kd>100.0</kd>
  </gazebo>
  <gazebo reference="steer_rear_link">
    <mu1>0.6</mu1><mu2>0.6</mu2><kp>1000000.0</kp><kd>100.0</kd>
  </gazebo>
  <gazebo reference="wheel_front_drive_link">
    <mu1>2.0</mu1><mu2>2.0</mu2><fdir1>1 0 0</fdir1><kp>1000000.0</kp><kd>100.0</kd>
    <maxVel>0.05</maxVel><minDepth>0.0</minDepth>
  </gazebo>
  <gazebo reference="wheel_rear_drive_link">
    <mu1>2.0</mu1><mu2>2.0</mu2><fdir1>1 0 0</fdir1><kp>1000000.0</kp><kd>100.0</kd>
    <maxVel>0.05</maxVel><minDepth>0.0</minDepth>
  </gazebo>
  <gazebo reference="wheel_front_left_link">
    <!-- Passive support has a free swivel DOF; it is not a fixed skid. -->
    <mu1>${passive_caster_mu1}</mu1><mu2>${passive_caster_mu2}</mu2><kp>1000000.0</kp><kd>100.0</kd>
  </gazebo>
  <gazebo reference="wheel_front_right_link">
    <mu1>${passive_caster_mu1}</mu1><mu2>${passive_caster_mu2}</mu2><kp>1000000.0</kp><kd>100.0</kd>
  </gazebo>
  <gazebo reference="wheel_rear_left_link">
    <mu1>${passive_caster_mu1}</mu1><mu2>${passive_caster_mu2}</mu2><kp>1000000.0</kp><kd>100.0</kd>
  </gazebo>
  <gazebo reference="wheel_rear_right_link">
    <mu1>${passive_caster_mu1}</mu1><mu2>${passive_caster_mu2}</mu2><kp>1000000.0</kp><kd>100.0</kd>
  </gazebo>

  <!-- Phase 5 - Gazebo Classic multi-ray 3D LiDAR.  A ray sensor is used
       instead of gpu_ray because this Gazebo version's gpu_ray supports only
       one vertical ray. -->
  <gazebo reference="lidar_link">
    <sensor name="lidar_3d" type="ray">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>${lidar_update_rate}</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>${lidar_horizontal_samples}</samples>
            <resolution>1</resolution>
            <min_angle>${-lidar_horizontal_fov / 2.0}</min_angle>
            <max_angle>${lidar_horizontal_fov / 2.0}</max_angle>
          </horizontal>
          <vertical>
            <samples>${lidar_vertical_samples}</samples>
            <resolution>1</resolution>
            <min_angle>${-lidar_vertical_fov / 2.0}</min_angle>
            <max_angle>${lidar_vertical_fov / 2.0}</max_angle>
          </vertical>
        </scan>
        <range>
          <min>${lidar_min_range}</min>
          <max>${lidar_max_range}</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>${lidar_noise_stddev}</stddev>
        </noise>
      </ray>
      <plugin name="lidar_3d_ros" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/lidar</namespace>
          <remapping>~/out:=points</remapping>
        </ros>
        <output_type>sensor_msgs/PointCloud2</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Phase 5 - IMU sensor. Noise is generated by Gazebo's sensor plugin. -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>${imu_update_rate}</update_rate>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>${imu_gyro_noise_stddev}</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>${imu_gyro_noise_stddev}</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>${imu_gyro_noise_stddev}</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>${imu_accel_noise_stddev}</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>${imu_accel_noise_stddev}</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>${imu_accel_noise_stddev}</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <plugin name="imu_ros" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/imu</namespace>
          <remapping>~/out:=data</remapping>
        </ros>
        <frame_name>imu_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Phase 2 - ros2_control hardware exported by Gazebo Classic.  The legacy
       gazebo_ros_joint_state_publisher is intentionally not used here - the
       joint_state_broadcaster below is the single source of /joint_states. -->
  <xacro:if value="$(arg enable_gazebo_ros2_control)">
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <joint name="steer_front_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="steer_rear_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wheel_front_drive_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wheel_rear_drive_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <parameters>$(find swerve_bringup)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>
  </xacro:if>
</robot>
