# Put these in frontend/.env when testing this Django backend. Empty base URLs
# make the browser resolve the Django hostname automatically, including LAN use.
VITE_DEMO_MODE=false
VITE_BACKEND_MODE=true
VITE_RUNTIME_MODE=GAZEBO_ROS
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
VITE_BACKEND_PORT=8000
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
