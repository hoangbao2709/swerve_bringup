DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TWIN_SEED=42
TWIN_AUTOPLAY=1
TWIN_AUTH_REQUIRED=1
WARETWIN_RUNTIME_MODE=GAZEBO_ROS
WARETWIN_ROS_BRIDGE_TOKEN=change-me
WARETWIN_ROS_HEARTBEAT_TIMEOUT_S=3.0
TWIN_ADMIN_USERNAME=admin
TWIN_ADMIN_EMAIL=admin@example.com
TWIN_ADMIN_PASSWORD=admin12345
# Optional AI later:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o-mini
