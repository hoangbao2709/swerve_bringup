# Generated build/runtime files
/build/
/install/
/log/
/logs/
/.runtime/
/artifacts/
/acceptance_full_*/
/benchmark_*/
/generated/

**/__pycache__/
*.py[cod]

# SQLite
# Ignore SQLite databases by default...
**/*.sqlite3

# ...but allow backend database to be committed
!waretwin/backend/*.sqlite3

# Never commit SQLite temporary/runtime files
**/*.sqlite3-shm
**/*.sqlite3-wal
**/*.sqlite3-journal

**/*.bak_*
*.bak
*~
*.orig

# Local dependency/build directories
**/node_modules/
**/dist/
**/.venv/
**/venv/
**/.mypy_cache/

# Local configuration and secrets. Keep templates tracked.
**/.env
**/.env.local
!**/.env.example