# Backend-connected mode
VITE_DEMO_MODE=false
VITE_BACKEND_MODE=true
VITE_RUNTIME_MODE=GAZEBO_ROS
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=5173

# If these are empty, the browser hostname is used automatically. This works
# for both same-PC and LAN access when Django listens on the same host.
VITE_BACKEND_PORT=8000
VITE_API_BASE_URL=
VITE_WS_BASE_URL=

# Legacy aliases remain supported for existing deployments:
# VITE_API_URL=http://127.0.0.1:8000
# VITE_WS_URL=ws://127.0.0.1:8000/ws

# Example when Django runs on another PC:
# VITE_API_URL=http://192.168.1.10:8000
# VITE_WS_URL=ws://192.168.1.10:8000/ws
