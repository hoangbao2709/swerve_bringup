#!/usr/bin/env python3
"""Operator client for the tag-only navigation API; it has no coordinate goal."""
import argparse
import threading
import time

import rclpy
from rclpy.action import ActionClient
from rclpy.executors import MultiThreadedExecutor
from rclpy.node import Node
from std_msgs.msg import Int32, String

from swerve_bringup.action import GoToTag


class TagOperator(Node):
    def __init__(self):
        super().__init__('tag_operator')
        self.client = ActionClient(self, GoToTag, '/go_to_tag')
        self.current = self.next = self.target = 0; self.state = 'UNANCHORED'; self.handle = None
        self.create_subscription(Int32, '/tag_navigation/current_tag', lambda m: setattr(self, 'current', m.data), 10)
        self.create_subscription(Int32, '/tag_navigation/next_tag', lambda m: setattr(self, 'next', m.data), 10)
        self.create_subscription(Int32, '/tag_navigation/target_tag', lambda m: setattr(self, 'target', m.data), 10)
        self.create_subscription(String, '/tag_navigation/state', lambda m: setattr(self, 'state', m.data), 10)

    def go_to_tag(self, tag_id):
        if self.handle is not None: print('[TAG_NAV] A mission is already active.'); return
        if not self.client.wait_for_server(timeout_sec=5.0): print('[TAG_NAV] /go_to_tag unavailable.'); return
        goal = GoToTag.Goal(); goal.target_tag_id = int(tag_id)
        self.client.send_goal_async(goal, feedback_callback=self.feedback).add_done_callback(self.accepted)

    def accepted(self, future):
        self.handle = future.result()
        if self.handle is None or not self.handle.accepted: self.handle = None; print('[TAG_NAV] Goal rejected.'); return
        self.handle.get_result_async().add_done_callback(self.result)

    def feedback(self, message):
        f = message.feedback; print(f'\r[TAG_NAV] {f.state}: {f.current_tag_id}->{f.next_tag_id}, target={f.target_tag_id} ({f.progress:.0%})', end='', flush=True)

    def result(self, future):
        print(); result = future.result().result; print(f'[TAG_NAV] {"ARRIVED" if result.success else "FAILED"}: {result.reason}'); self.handle = None

    def status(self): print(f'[TAG_NAV] state={self.state} current={self.current} next={self.next} target={self.target}')
    def cancel(self):
        if self.handle: self.handle.cancel_goal_async()


def main():
    parser = argparse.ArgumentParser(description='Tag-only AGV operator client'); parser.add_argument('--tag', type=int)
    args, ros_args = parser.parse_known_args(); rclpy.init(args=ros_args or None)
    node = TagOperator(); executor = MultiThreadedExecutor(); executor.add_node(node); thread = threading.Thread(target=executor.spin, daemon=True); thread.start()
    try:
        if args.tag is not None:
            node.go_to_tag(args.tag)
            while rclpy.ok() and node.handle is not None: time.sleep(.1)
        else:
            print('Commands: go_to_tag TAG_ID | status | cancel | quit')
            while rclpy.ok():
                command = input('agv> ').strip().split()
                if command and command[0] == 'go_to_tag' and len(command) == 2: node.go_to_tag(int(command[1]))
                elif command and command[0] == 'status': node.status()
                elif command and command[0] == 'cancel': node.cancel()
                elif command and command[0] in ('quit', 'exit', 'q'): break
    finally:
        executor.shutdown(); node.destroy_node(); rclpy.shutdown()


if __name__ == '__main__': main()
